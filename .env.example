# Docker Compose overrides
DERIVLAB_BIND_ADDR=127.0.0.1
DERIVLAB_PORT=8501
TZ=UTC

# Optional local paths (defaults already point at ./data)
# DERIVLAB_DATA_DIR=./data/cache
# DERIVLAB_SEED_DIR=./data/seed


# ---------------------------------------------------------------------------
# Optional AI agents (the app works fully offline without these)
# ---------------------------------------------------------------------------
# local = deterministic local models. Use openai, anthropic, openai_compatible,
# ollama, lmstudio, or vllm to call a live model.
DERIVLAB_LLM_PROVIDER=local
DERIVLAB_LLM_BASE_URL=
# Never commit a real key. Put it in your shell environment or a gitignored .env.
DERIVLAB_LLM_API_KEY=
# Optional shared default for all three roles:
DERIVLAB_LLM_MODEL=
# Per-role overrides:
DERIVLAB_DECISION_MODEL=
DERIVLAB_CRITIC_MODEL=
DERIVLAB_NEWS_MODEL=
DERIVLAB_LLM_TIMEOUT=25
DERIVLAB_LLM_TEMPERATURE=0.55
